# Copy to .env (repo root) for local development. Never commit real secrets.
DATABASE_URL=postgres://thrift:thrift@localhost:5432/thrift_dev
TEST_DATABASE_URL=postgres://thrift:thrift@localhost:5432/thrift_test

# Public base URL used for callbacks and share links.
APP_BASE_URL=http://localhost:3000

# 32+ random bytes, hex. Signs media URLs and sandbox webhooks.
APP_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef

# Payment provider: "sandbox" (default, clearly labelled, no real money) or "paystack".
PAYMENT_PROVIDER=sandbox
PAYSTACK_SECRET_KEY=

# Courier provider: "sandbox" (default) or a real adapter once contracted.
COURIER_PROVIDER=sandbox

# Local object storage directory for uploaded media (dev only).
MEDIA_STORAGE_DIR=.data/media

# Worker loop interval in milliseconds.
WORKER_TICK_MS=5000
